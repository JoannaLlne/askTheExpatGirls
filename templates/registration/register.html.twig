{% extends 'base.html.twig' %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('styles/css/register.css') }}">
{% endblock %}

{% block title %}Create an account{% endblock %}

{% block body %}
    {% for flash_error in app.flashes('verify_email_error') %}
        <div class="alert alert-danger" role="alert">{{ flash_error }}</div>
    {% endfor %}

    <section class="user-container">
        <div class="icon">
            <span></span>
            <i class="fa-regular fa-user"></i>
            <span></span>
        </div>
        <div class="registration-card">
            <h1>Register</h1>
            <p class="registration">Create your account to access to your application(s).</p>

            {{ form_start(registrationForm) }}
            {{ form_errors(registrationForm) }}

            {{ form_row(registrationForm.firstName) }}

            {{ form_row(registrationForm.lastName) }}

            {{ form_row(registrationForm.email) }}

            {{ form_row(registrationForm.phone) }}


            {{ form_row(registrationForm.plainPassword) }}
            <div id="passwordError"></div>


            <div class="register-checkbox">
                {{ form_widget(registrationForm.agreeTerms) }}
                {{ form_label(registrationForm.agreeTerms) }}
            </div>
            {{ form_errors(registrationForm.agreeTerms) }}

            <button type="submit" class="btn-register">
                Create my account
            </button>

            <small class="login-link">Already have an account?
                <a href="{{ path('app_login') }}">Log in</a>
            </small>

            {{ form_end(registrationForm) }}

        </div>
    </section>
{% endblock %}
