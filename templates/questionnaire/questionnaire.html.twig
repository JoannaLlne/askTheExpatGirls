{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('styles/css/questionnaire.css') }}">
{% endblock %}

{% block body %}
<div class="qr-page">

    <div class="questContainer">
    <div class="questForm">

        <h3>Send us a message</h3>
        <h1>How can we help ?</h1>

        {{ form_start(questionnaireForm, {'action': path('new_questionnaire')}) }}
        {{ form_errors(questionnaireForm) }}
        <div class="qr-field">
            {{ form_label(questionnaireForm.firstName) }}
            {{ form_widget(questionnaireForm.firstName, {attr: {readonly: app.user is not null}}) }}
            {{ form_errors(questionnaireForm.firstName) }}
        </div>

        <div class="qr-field">
            {{ form_label(questionnaireForm.lastName) }}
            {{ form_widget(questionnaireForm.lastName, {attr: {readonly: app.user is not null}}) }}
            {{ form_errors(questionnaireForm.lastName) }}
        </div>

        <div class="qr-field email-field">
            {{ form_label(questionnaireForm.email) }}
            {{ form_widget(questionnaireForm.email, {attr: {readonly: app.user is not null}}) }}
            {{ form_errors(questionnaireForm.email) }}
        </div>
        <div class="newsletter-field">
            {{ form_widget(questionnaireForm.newsletter) }}
            {{ form_label(questionnaireForm.newsletter) }}
        </div>
            <div class="qr-field">
                {{ form_label(questionnaireForm.nationality) }}
                {{ form_widget(questionnaireForm.nationality) }}
                {{ form_errors(questionnaireForm.nationality) }}
            </div>
            <div class="qr-field">
                {{ form_label(questionnaireForm.situation) }}
                {{ form_widget(questionnaireForm.situation) }}
                {{ form_errors(questionnaireForm.situation) }}
            </div>
            <div class="qr-field">
                {{ form_label(questionnaireForm.helpReason) }}
                {{ form_widget(questionnaireForm.helpReason) }}
                {{ form_errors(questionnaireForm.helpReason) }}
            </div>
        <div class="qr-field">
            {{ form_label(questionnaireForm.service) }}
            {{ form_widget(questionnaireForm.service) }}
            {{ form_errors(questionnaireForm.service) }}
        </div>
            <div class="qr-field">
                {{ form_label(questionnaireForm.additionalInfo) }}
                {{ form_widget(questionnaireForm.additionalInfo) }}
                {{ form_errors(questionnaireForm.additionalInfo) }}
                <br><small class="qr-confidentiality">Please only share information relevant to your request. Do not include sensitive personal information.</small>
            </div>

        <div class="honeypot" aria-hidden="true">
            {{ form_widget(questionnaireForm.website, {attr: {tabindex: '-1', autocomplete: 'off'}}) }}
        </div>

        <div class="btns">
            <button class="btn btnSubmit">Submit</button>
            <a class="btn btnReturn" href="{{ path('main_index') }}">Back</a>
        </div>

        <small class="qr-confidentiality">Your information is kept confidential and will only be used to process your request and provide you with a response. For more information about how we collect, use and protect your personal data, please read our Privacy Policy.</small>
        {{ form_end(questionnaireForm) }}
    </div>
    </div>
</div>
{% endblock %}

