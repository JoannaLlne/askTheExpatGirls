{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('styles/css/questionnaire.css') }}">
{% endblock %}


{% block body %}
<div class="qr-page">
    {#  <h1 id="qr-title">Hello {{ app.user.firstName }}</h1> #}

    <div class="questContainer">
    <div class="questForm">
        {{ form_start(questionnaireForm, {'action': path('new_questionnaire')}) }}

            <div class="qr-field">
                <p>First name : {{ app.user.firstName }}</p>
            </div>
            <div class="qr-field">
                <p>Last name : {{ app.user.lastName }}</p>
            </div>
            <div class="qr-field">
                {{ form_label(questionnaireForm.nationality) }}
                {{ form_widget(questionnaireForm.nationality) }}
                {{ form_errors(questionnaireForm.nationality) }}
            </div>
            <div class="qr-field">
                {{ form_label(questionnaireForm.situation) }}
                {{ form_widget(questionnaireForm.situation) }}
                {{ form_errors(questionnaireForm.situation) }}
            </div>
            <div class="qr-field">
                {{ form_label(questionnaireForm.helpReason) }}
                {{ form_widget(questionnaireForm.helpReason) }}
                {{ form_errors(questionnaireForm.helpReason) }}
            </div>
            <div class="qr-field">
                {{ form_label(questionnaireForm.additionalInfo) }}
                {{ form_widget(questionnaireForm.additionalInfo) }}
                {{ form_errors(questionnaireForm.additionalInfo) }}
            </div>


        <div class="btnList">
            <button class="btn btnSubmit">Submit</button>

            <a class="btn btnReturn" href="{{ path('main_index') }}">Back</a>

        </div>

        <p class="qr-confidentiality">Your information is kept confidential and will only be used to process your request and provide you with a response. For more information about how we collect, use and protect your personal data, please read our Privacy Policy.</p>
        {{ form_end(questionnaireForm) }}
    </div>

        <div class="textForm">
            <div>
                <h2>Your questionnaire</h2>
                <p class="panel-text">Fill out the form with all your information, and we will get back to you as soon as possible.</p>
            </div>
            <p id="signature">The Expat Girls</p>
        </div>
    </div>
</div>
{% endblock %}

