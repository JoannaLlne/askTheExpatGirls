{% extends 'base.html.twig' %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('styles/css/form.css') }}">
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('styles/js/password-check.js') }}" defer></script>
{% endblock %}


{% block title %}Sign in{% endblock %}

{% block body %}

<h1 class="h1">Create an account</h1>

<div class="containerForm">
    {{ form_start(userForm) }}

    <ul id="containerCreateUser">
        <li class="input">
            {{ form_row(userForm.lastName) }}
        </li>

        <li class="input">
            {{ form_row(userForm.firstName) }}
        </li>

        <li class="input">
            {{ form_row(userForm.email) }}
        </li>

        <li class="input">
            {{ form_row(userForm.phone) }}
        </li>

        <li class="input">
            {{ form_row(userForm.password) }}
        </li>
    </ul>
    <span id="passwordError" class="error"></span>

    <div class="btnList">
        <button class="btn btnSave">Save</button>
        {#     <button class="btn btn-sm btn-primary">{{ wishForm.vars.value.id == null ? 'Create' : 'Modify' }}</button>
        #}

        <button class="btn btnReturn">
            <a href="{{ path('main_index') }}">Retour</a>
        </button>
    </div>

    {{ form_end(userForm) }}

</div>

{% endblock %}
