{% extends 'base.html.twig' %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('styles/css/form.css') }}">
{% endblock %}

{% block title %}My profile{% endblock %}

{% block body %}
<section id="containerProfile">
    <div class="hello">
        {% if app.user and app.user.id == user.id %}
            <h1>Hello {{ user.firstName }}</h1>
            <h2>My profile</h2>
        {% endif %}
    </div>

    <div class="profile-grid">
    <div class="profile-card profile-info">
            <table id="infos">
                <h3>My personal information</h3>
                <tr>
                    <th>First name</th>
                    <td>{{ user.firstName }}</td>
                </tr>

                <tr>
                    <th>Last name</th>
                    <td>{{ user.lastName }}</td>
                </tr>

                <tr>
                    <th>Email</th>
                    <td>{{ user.email }}</td>
                </tr>

                <tr>
                    <th>Phone</th>
                    {% if user.phone %}
                    <td>{{ user.phone }}</td>
                    {% else %}
                        <td>No phone number added</td>
                    {% endif %}
                </tr>
            </table>

        {% if app.user and app.user.id == user.id %}
            <a type="button" class="btn btnModify" href="{{ path('user_update', {id:app.user.id})}}">Modify</a>
        {% endif %}
    </div>

        <div class="profile-card application-card">
            {% block account_content %}
                {% for application in applications %}
                    <div class="application-item">
                        <div class="application-header">
                            <div>
                                <h3>{{ application.service.name }}</h3>
                                <p class="application-date">
                                    Submitted on {{ application.createdAt|date('d/m/Y') }}
                                </p>
                            </div>

                            <span class="status-badge">
                        {{ application.status.label() }}
                    </span>
                        </div>


                        {# Progress timeline #}
                        <div class="application-progress">
                            <div class="progress-line">
                                <div class="progress-line-fill"
                                    style=" width: {{ ((application.status.step() - 1) / 3) * 100 }}%;">
                                </div>
                            </div>

                            <div class="progress-steps">
                                {# Step 1 #}
                                <div class="progress-step {{ application.status.step() >= 1 ? 'completed' : '' }} {{ application.status.step() == 1 ? 'current' : '' }}">
                                    <div class="step-circle">
                                        {% if application.status.step() > 1 %}
                                            ✓
                                        {% else %}
                                            1
                                        {% endif %}
                                    </div>
                                    <span>New</span>
                                </div>


                                {# Step 2 #}
                                <div class="progress-step {{ application.status.step() >= 2 ? 'completed' : '' }} {{ application.status.step() == 2 ? 'current' : '' }}">
                                    <div class="step-circle">
                                        {% if application.status.step() > 2 %}
                                            ✓
                                        {% else %}
                                            2
                                        {% endif %}
                                    </div>
                                    <span>Pending</span>
                                </div>


                                {# Step 3 #}
                                <div class="progress-step {{ application.status.step() >= 3 ? 'completed' : '' }} {{ application.status.step() == 3 ? 'current' : '' }}">
                                    <div class="step-circle">
                                        {% if application.status.step() > 3 %}
                                            ✓
                                        {% else %}
                                            3
                                        {% endif %}
                                    </div>
                                    <span>In Progress</span>
                                </div>


                                {# Step 4 #}
                                <div class="progress-step {{ application.status.step() >= 4 ? 'completed' : '' }} {{ application.status.step() == 4 ? 'current' : '' }}">
                                    <div class="step-circle">
                                        {% if application.status.step() > 4 %}
                                            ✓
                                        {% else %}
                                            4
                                        {% endif %}
                                    </div>
                                    <span>Processed</span>
                                </div>
                            </div>
                        </div>

                        {# Current status message #}
                        <div class="application-status-message">
                            {% if application.status.step() == 1 %}
                                <strong>Your application has been received.</strong>
                                <p>We have received your application and will review it shortly.</p>

                            {% elseif application.status.step() == 2 %}
                                <strong>Your application is pending.</strong>
                                <p>We are currently reviewing the information provided.</p>

                            {% elseif application.status.step() == 3 %}
                                <strong>Your application is in progress.</strong>
                                <p>Our team is currently working on your request.</p>

                            {% elseif application.status.step() == 4 %}
                                <strong>Your application has been processed.</strong>
                                <p>Your request has been processed. Thank you for your patience.</p>
                            {% endif %}
                        </div>
                        <div class="appointment-status">
                            <strong>Your appointment(s) :</strong>
                            {% for appointment in application.appointment %}
                                <p>{{ appointment.date|date('d/m/Y \\a\\t H:i') }} — {{ appointment.status.value }}</p>
                                {% if appointment.status.name == 'BOOKED' %}
                                    <form method="post" action="{{ path('appointment_cancel', {id: appointment.id}) }}" data-turbo="false" onsubmit="return confirm('Cancel this appointment?');">
                                        <input type="hidden" name="_token" value="{{ csrf_token('cancel-' ~ appointment.id) }}">

                                        <button type="submit" class="btn btn-cancel">Cancel appointment</button>
                                    </form>
                                {% endif %}
                            {% else %}
                                <p>No appointment yet.</p>
                            {% endfor %}
                        </div>
                        <a class="btnBook" href="{{ path('appointment_book', {id:application.id}) }}">Book an appointment</a>
                    </div>

                {% else %}
                    <div class="no-application"><p>You don't have any request.</p></div>
                {% endfor %}
            {% endblock %}
        </div>
    </div>

    <div class="container-btn">
        <a class="btnNewApp" href="{{ path('contact_page') }}">New application</a>
        <a class="btn btnReturn" href="{{ path('main_index') }}">Return</a>
    </div>
</section>

{% endblock %}
