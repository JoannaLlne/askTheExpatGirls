{% extends 'base.html.twig' %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('styles/css/form.css') }}">
{% endblock %}

{% block title %}My profile{% endblock %}

{% block body %}
<section id="containerProfile">
    <div class="hello">
        {% if app.user and app.user.id == user.id %}
            <h1>Hello {{ user.firstName }}</h1>
            <h2>My profile</h2>
        {% endif %}
    </div>

    <div class="profile-grid">
    <div class="profile-card">
            <table id="infos">
                <h3>My personal information</h3>
                <tr>
                    <th>First name</th>
                    <td>{{ user.firstName }}</td>
                </tr>

                <tr>
                    <th>Last name</th>
                    <td>{{ user.lastName }}</td>
                </tr>

                <tr>
                    <th>Email</th>
                    <td>{{ user.email }}</td>
                </tr>

                <tr>
                    <th>Phone</th>
                    {% if user.phone %}
                    <td>{{ user.phone }}</td>
                    {% else %}
                        <td>No phone number added</td>
                    {% endif %}
                </tr>
            </table>

        {% if app.user and app.user.id == user.id %}
            <a type="button" class="btn btnModify" href="{{ path('user_update', {id:app.user.id})}}">Modify</a>
        {% endif %}
    </div>

    <div class="profile-card">
        {% block account_content %}
        <table id="application">

            {% for application in applications %}
                <h3>{{ application.service.name }}</h3>

                <tr>
                    <th>Submitted : </th>
                    <td>{{ application.createdAt|date('d/m/Y') }}</td>
                </tr>

                <tr>
                    <th>Status : </th>
                    <td>{{ application.status.value }} </td>
                </tr>

            {% else %}
                <p>You don't have any request.</p>
            {% endfor %}
        </table>
        {% endblock %}
    </div>
    </div>

    <div class="container-btn">
        <a type="button" class="btn btnReturn" href="{{ path('main_index') }}">Return</a>
    </div>
</section>

{% endblock %}
