{% extends 'base.html.twig' %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('styles/css/form.css') }}">
{% endblock %}

{% block title %}My profile{% endblock %}

{% block body %}
<div id="containerProfile">
    <div>
        {% if app.user and app.user.id == user.id %}
            <h1>My profile</h1>
        {% endif %}
    </div>

    <div class="containerTable">
            <table id="table">
                <tr>
                    <th>First name</th>
                    <td>{{ user.firstName }}</td>
                </tr>

                <tr>
                    <th>Last name</th>
                    <td>{{ user.lastName }}</td>
                </tr>

                <tr>
                    <th>Email</th>
                    <td>{{ user.email }}</td>
                </tr>
            </table>
    </div>

    <div class="container-btn">
        {% if app.user and app.user.id == user.id %}
            <a type="button" class="btn btnModify" href="{{ path('user_update', {id:app.user.id})}}">Modify</a>
        {% endif %}

        <a type="button" class="btn btnReturn" href="{{ path('main_index') }}">Return</a>
    </div>
</div>

{% endblock %}
