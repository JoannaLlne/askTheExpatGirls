{% extends 'base.html.twig' %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('styles/css/register.css') }}">
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('styles/js/password-check.js') }}" defer></script>
{% endblock %}

{% block title %}Sign in{% endblock %}

{% block body %}

    <section class="user-container">
<div class="registration-card">
    <h1 class="h1">Update my info</h1>
    {{ form_start(userForm) }}

    {{ form_row(userForm.lastName) }}

    {{ form_row(userForm.firstName) }}

    {{ form_row(userForm.email) }}

    {{ form_row(userForm.phone) }}

    {{ form_row(userForm.password.first, {
        attr: {
            placeholder: 'Leave empty to keep the same'}
    }) }}

    {{ form_row(userForm.password.second, {
        attr: {
            placeholder: 'Leave empty to keep the same'}
    }) }}

    <span id="passwordError" class="error"></span>

    <div class="btnList">
        <button class="btn btnSave">Save</button>
        <a class="btn btnReturn" href="{{ path('main_index') }}">Back</a>
    </div>

    {{ form_end(userForm) }}

</div>
</section>
{% endblock %}

