{% block javascripts %}
    <script src="{{ asset('styles/js/menu.js') }}" defer></script>
{% endblock %}

<nav class="navbar">

        <div class="logo">
            <img id="logo" src="{{ asset('images/Logo-ATEG.png') }}" alt="logo">
            <!-- <h2>Ask the Expat Girls</h2> -->
        </div>

            <div class="nav-menu">
            <ul>
                {% if app.user %}
                {% if is_granted("ROLE_ADMIN") %}
                <li class="nav-li">
                    <a class="nav-link" href="{{ path('admin') }}"
                       title="Administration">
                        Administration
                    </a>
                </li>
                {% endif %}
                {% endif %}

                <li class="nav-li">
                    <a class="nav-link" href="{{ path('main_index') }}"
                       title="Go to home page">
                        Home
                    </a>
                </li>

                <li class="nav-li nav-li-dropdown">
                    <button class="nav-link nav-dropdown-toggle" type="button">
                        Our services
                        <span class="nav-arrow"></span>
                    </button>
                    <ul class="nav-dropdown-menu">
                        <li>
                            <a class="nav-dropdown-link" href="{{ path('main_service') }}"
                               title="See services">
                                Services
                            </a>
                        </li>
                        <li>
                            <a class="nav-dropdown-link" href="{{ path('expat_packages') }}"
                               title="See Expat Packages">
                                Expat Packages
                            </a>
                        </li>
                    </ul>
                </li>

                <li class="nav-li">
                    <a class="nav-link" href="{{ path('contact_page') }}"
                       title="See contact">
                        Contact
                    </a>
                </li>

                {% if app.user %}
                {% if is_granted("ROLE_USER") %}
                <li class="nav-li">
                    <a class="nav-link" href="{{ path('user_profile', {id:app.user.id}) }}"
                       title="See my profile">
                        My profile
                    </a>
                </li>
            {% endif %}
            {% endif %}
            </ul>
            </div>

            <div class="nav-btn">
                {% if not app.user %}
            <a class="btn btnLogin" href="{{ path('app_login') }}">Login</a>
                {% else %}
            <a class="btn btnLogout" href="{{ path('app_logout') }}">Logout</a>
                {% endif %}
        </div>
</nav>
