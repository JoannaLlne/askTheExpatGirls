{% extends 'base.html.twig' %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('styles/css/contact.css') }}">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.3.1/css/all.min.css" integrity="sha512-QeR2VH+lsBE5LSAe1Q5EnTBbe7XTBubt8dG93Y7gidSgdMCr8nVqKcfKAMyN96SV8KDbZVTDXChatu5G2KQGzg==" crossorigin="anonymous" referrerpolicy="no-referrer">
{% endblock %}

{% block title %}Contact{% endblock %}

{% block body %}
    <section id="contact-container">
        <div class="container1">
            <h1>Contact</h1>
            <p>You have a question ? We are ready to help !</p>
        </div>

        <div class="container2">
            <div class="contact-grid">
                <div class="contact-information">
                    <h2>Here our information</h2>

                    <div class="contact-information-item">
                        <h3>Phone / Whatsapp</h3>
                        <p>+33 67 17 94 386</p>
                    </div>

                    <div class="contact-information-item">
                        <h3>Email</h3>
                        <p><a href="mailto:info@asktheexpatgirls.com">info@asktheexpatgirls.com</a></p>
                    </div>

                    <div class="contact-information-item">
                        <h3>Opening hours</h3>
                        <p>Monday - Friday</p>
                        <p id="hours">9am - 7pm</p>
                    </div>

                    <div class="social-networks">
                        <h3>Follow us on social media for some tips</h3>
                        <a href="https://www.instagram.com/asktheexpatgirls"><i class="fa-brands fa-square-instagram"></i></a>
                        <a href="https://www.facebook.com/asktheexpatgirls/"><i class="fa-brands fa-square-facebook"></i></a>
                        <a href="https://www.linkedin.com/in/ask-the-expat-girls-81b9422ab/"><i class="fa-brands fa-square-linkedin"></i></a>
                    </div>
                </div>

               <div class="contact-quest">
                   <!-- <p id="contactP">You want to ask us about a service ? <br>
                    Fill out a form to leave us your information, we'll come back to you as soon as possible </p> -->
                        {{ render(controller('App\\Controller\\QuestionnaireController::create')) }}
                </div>
            </div>
        </div>
    </section>
{% endblock %}
