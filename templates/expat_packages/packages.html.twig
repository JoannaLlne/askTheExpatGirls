{% extends 'base.html.twig' %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('styles/css/services.css') }}">
{% endblock %}

{% block title %}Expat Packages{% endblock %}

{% block body %}


<main class="packages-page">
    <section class="packages-header">
        <div class="packages-header-left">
            <div class="text-left">
                <h5>Personalized expat support</h5>
                <h1>Expat Packages</h1>

                <h2>A simpler way to settle <br>
                    into your new life in France.</h2>

                <p>Below is an overview of our packages. The services included in the packages are examples and is not
                    an exhaustive list – we’re happy to adapt and offer additional support based on your needs. They are designed to
                    help you settle into France smoothly, tailored to fit your individual needs & wants,
                    and to give you ongoing administrative assistance whilst your settle into your new life in France.</p>
            </div>
        </div>

        <div class="packages-header-img">
            <div class="packages-img-gold"></div>
            <div class="packages-header-img-main">
            <img src="{{ asset('images/photo1.jpg') }}" alt="Vew over Paris">
            </div>
        </div>
    </section>

    <section class="packages-note">
        <div class="packages-note-content">
            <div class="packages-note-title">
                <p>Tailored to you</p>
                <h2>Every move is different.</h2>
            </div>

            <div class="packages-note-text">
                <p>
                    We can adapt the support to your individual needs and provide
                    additional assistance where needed.
                </p>
            </div>
        </div>
    </section>

<section class="packages-results">
    <div class="packages-list">
        {% for package in packages %}
            <article class="package-card">
                <div class="package-card-image">
                {% if package.image %}
                    <img src="{{ asset('uploads/packages/' ~ package.image) }}" alt="{{ package.name }}">
                {% else %}
                    <img src="{{ asset('images/default-packages.jpg') }}" alt="{{ package.name }}">
                {% endif %}
                </div>

                <div class="packages-text">
                    <h4>Expat package</h4>
                    <h3>{{ package.name }}</h3>

                    <div class="packages-description">
                        {{ package.description|sanitize_html('admin_content')}}
                    </div>

                {% if package.price !== null %}
                    <p class="card-price">{{ package.price }} €</p>
                {% else %}
                    <p>On request</p>
                {% endif %}

                <a href="{{ path('contact_page') }}" class="packages-btn">
                    Get in touch<span aria-hidden="true">→</span></a>
                </div>
            </article>
        {% endfor %}
    </div>
</section>
</main>
{% endblock %}
