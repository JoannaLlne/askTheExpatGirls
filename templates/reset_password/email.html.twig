{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('styles/css/reset-password.css') }}">
{% endblock %}

{% block body %}
<section class="email-container">

    <div class="reset-card">
        <h3>Ask the Expats Girls</h3>
        <h1>Hi !</h1>

        <p> You requested to reset your password. </p>
        <p>To reset your password, please click the button below</p>
        <a class="btn btnReset" href="{{ url('app_reset_password', {token: resetToken.token}) }}">{{ url('app_reset_password', {token: resetToken.token}) }}</a>

        <p class="expiration">This link will expire in {{ resetToken.expirationMessageKey|trans(resetToken.expirationMessageData, 'ResetPasswordBundle') }}.</p>
        <small class="security-message"> If you did not request a password reset, you can safely ignore this email. </small>

        <p>Cheers!</p>
    </div>

</section>
{% endblock %}
