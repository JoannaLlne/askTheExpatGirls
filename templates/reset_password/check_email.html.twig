{% extends 'base.html.twig' %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('styles/css/reset-password.css') }}">
{% endblock %}

{% block title %}Password Reset Email Sent{% endblock %}

{% block body %}
    <section class="reset-sent">
        <div class="reset-text">
            <p> If an account matching your email exists, then an email was just sent that contains a link that you can use to reset your password.
                This link will expire in {{ resetToken.expirationMessageKey|trans(resetToken.expirationMessageData, 'ResetPasswordBundle') }}.</p>
            <p class="re-sent">If you don't receive an email please check your spam folder or <a class="reset-link" href="{{ path('app_forgot_password_request') }}">try again</a>.</p>
        </div>
    </section>
{% endblock %}
