{% extends 'base.html.twig' %}

{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('js/newsletter.js') }}" defer></script>
{% endblock %}

{% block title %}Ask the Expat Girls{% endblock %}

{% block body %}
<main id="home-page">
    <section class="header">
        <div class="header-container">
        <h3>Your expat partner in France</h3>
        <h1>Moving to France doesn’t need to be so difficult. </h1>
            <p>The French bureaucratic system can be over whelming, especially if you don’t have a
                high level of French. We’re here to take the hassle of the French administration process
                away from you!</p>

            <div class="header-btn">
                <a class="btn btnHeader" href="{{ path('main_service') }}">Learn more</a>
                <a class="btn btnHeader" href="{{ path('contact_page') }}">Contact</a>
            </div>
        </div>

        <div class="header-visual">
            <div class="header-photo-gold"></div>
            <div class="header-photo-main">
                <img src="{{ asset('images/bg.jpg') }}" alt="Basque country coast">
            </div>
        </div>
    </section>

    <section id="newsletter-band">
        <div class="newsletter-text">
        <h3>Newsletter</h3>
        <p>Get practical visa updates, moving to France tips, French admin guidance and exclusive resources – straight to your inbox!
            <br> Sign up to our Newsletter for FREE today</p>
        </div>
        {{ render(controller('App\\Controller\\NewsletterController::subscribe', {placement: 'home_middle'})) }}
    </section>

    <section id="content-service">
                <div class="service-intro">
                <h3>Our Services</h3>
                    <h2>Expat services to help you settle into France easier</h2>
                    <p>We’re here to help you with whatever your query is, from visa
                        application, to general living advice, We’re here to answer all your
                        question</p>
                    </div>

                <div class="service-grid">
                    <article class="service-intro-card">
                        <div class="service-icon"><i class="fa-solid fa-passport"></i></div>
                        <h3>Visa & residence</h3>
                        <p>We help you with your visa application and residence permit process.</p>
                    </article>

                    <article class="service-intro-card">
                        <div class="service-icon"><i class="fa-solid fa-house"></i></div>
                        <h3>Daily life</h3>
                        <p>From bank accounts to utilities, we guide you through the practicalities.</p>
                    </article>

                    <article class="service-intro-card">
                        <div class="service-icon"><i class="fa-solid fa-children"></i></div>
                        <h3>Family</h3>
                        <p>Support for your family, from schools to healthcare and beyond.</p>
                    </article>

                    <article class="service-intro-card">
                        <div class="service-icon"><i class="fa-solid fa-earth-europe"></i></div>
                        <h3>Translations</h3>
                        <p>We offer guided translations of documents and other requests.</p>
                    </article>
                </div>

        <a href="{{ path('main_service') }}" class="btnHome">Discover our services</a>
        </section>

    <section class="presentation">
        <div class="about-visual">
            <div class="about-photo-gold"></div>
            <div class="about-photo">
                <img class="img" src="{{ asset('images/ZoeVicky.jpg') }}" alt="Vicky and Zoe from Ask the Expat Girls">
            </div>
        </div>

        <div class="presensation-text">
            <h3>About us</h3>
            <h2>Hi, we're Zoe & Vicky!</h2>
            <p>Vicky and Zoe, the owners of Ask the Expat Girls, have lived in France for over
                ten years and know first hand how tricky and over whelming settling into a new
                country can be. We’ve set up this business to help ot her expats like us adapt
                to French lifestyle more easily!</p>
        </div>
        <a href="{{ path('about_page') }}" class="btnHome">Learn more<span>→</span></a>
    </section>

    <section class="contactUs">
        <h3>Ready to move in France ?</h3>
        <h2>We are here to help !</h2>
        <p>We will hold your hand every step of the way, and help you to get settled into France.
            Fill out a form to give us your infos, and we'll reach out to you.</p>
        <a href="{{ path('contact_page') }}" class="btn btnContact">
            Contact us<span>→</span></a>
    </section>
</main>
{% endblock %}

