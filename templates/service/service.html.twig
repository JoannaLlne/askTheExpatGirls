{% extends 'base.html.twig' %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('styles/css/service.css') }}">
{% endblock %}

{% block title %}Services{% endblock %}

{% block body %}

<div class="service-container">
    <h1>Expat Services</h1>

    <div class="caroussel-img">
    <img id="photo" src="{{ asset('images/photo1.jpg') }}" alt="Vew over Paris">
    <img id="photo" src="{{ asset('images/photo2.jpg') }}" alt="Paris's street">
    <img id="photo" src="{{ asset('images/photo3.jpg') }}" alt="Picnic">
    <img id="photo" src="{{ asset('images/photo4.jpg') }}" alt="Patisserie terrace">
    </div>


    {{ form_start(form) }}
    <div class="filter-select">
        {{ form_label(form.timing) }}
        {{ form_widget(form.timing) }}
    </div>

    <div class="filter-checkboxes">
        <label>Catégories</label>
        {% for child in form.categories %}
            <div class="form-check">
                {{ form_widget(child) }}
                {{ form_label(child) }}
            </div>
        {% endfor %}
    </div>

    <button type="submit">Filtrer</button>
    {{ form_end(form) }}

    <div class="services-list">
        {% for service in services %}
            <div class="service-card">
                <h3>{{ service.name }}</h3>
                {% for t in service.serviceTimingEnums %}
                    <span>{{ t.label }}</span>
                {% endfor %}

                {% for c in service.serviceCategoryEnums %}
                    <span>{{ c.label }}</span>
                {% endfor %}
            </div>
        {% else %}
            <p>Aucun service ne correspond à ces critères.</p>
        {% endfor %}
    </div>
</div>
{% endblock %}
