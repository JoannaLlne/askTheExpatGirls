{% extends 'base.html.twig' %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('styles/css/service.css') }}">
{% endblock %}

{% block title %}Services{% endblock %}

{% block body %}

<section class="service-container">
    <h1>Expat Services</h1>

    <div class="caroussel-img">
    <img id="photo" src="{{ asset('images/photo1.jpg') }}" alt="Vew over Paris">
    <img id="photo" src="{{ asset('images/photo2.jpg') }}" alt="Paris's street">
    <img id="photo" src="{{ asset('images/photo3.jpg') }}" alt="Picnic">
    <img id="photo" src="{{ asset('images/photo4.jpg') }}" alt="Patisserie terrace">
    </div>

    <div id="service-description">
    {{ form_start(form) }}
        <div class="filter-container">
    <div class="filter-select">
        {{ form_label(form.timing) }}
        {{ form_widget(form.timing) }}
    </div>

    <div class="filter-checkboxes">
        <label>Catégories</label>
        <div class="filter-checkbox-container">
        {% for child in form.categories %}
            <div class="form-check">
                {{ form_widget(child) }}
                {{ form_label(child) }}
            </div>
        {% endfor %}
        </div>
    </div>


    <button class="btn btnSubmit" type="submit">Filtrer</button>
    {{ form_end(form) }}
    </div>

    <div class="service-list">
        {% for service in services %}
            <div class="service-card">
                <h3>{{ service.name }}</h3>
                <p>{{ service.description|raw }}</p>
                <p class="card-price">{{ service.price }} €</p>
            </div>
        {% endfor %}
    </div>
</div>
</section>
{% endblock %}

